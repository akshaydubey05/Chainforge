# ---- frontend ----
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ---- backend ----
FROM golang:alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/chainforge ./cmd/node

# ---- runtime ----
FROM alpine:3.20
RUN adduser -D -u 10001 app && mkdir /data && chown app /data
COPY --from=build /out/chainforge /usr/local/bin/chainforge
COPY --from=web /web/dist /app/web
USER app
WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["chainforge"]